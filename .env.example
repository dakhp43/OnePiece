# Leave DATABASE_URL empty to use the embedded PGlite database in data/pglite (no setup).
# Tiger Cloud: postgres://user:pass@host:port/tsdb?sslmode=require
DATABASE_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_medical
USE_KEYTERMS=false            # keyterm prompting costs extra; enable only if quota allows
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash       # gemini-2.5-* is retired for new keys
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
BACKBOARD_API_KEY=
BACKBOARD_ENABLED=true
EMAIL_PROVIDER=gmail          # gmail | resend
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
AUTH_SECRET=                  # 32+ random chars
DEMO_FALLBACK=true            # on external failure, load cached results
DEMO_PATIENT_EMAIL=           # teammate inbox used for the seeded demo patient

# Free-tier guards (lib/usage.ts)
GEMINI_DAILY_CALL_LIMIT=150
STT_DAILY_AUDIO_MINUTES=30
MAX_RECORDING_MINUTES=10

# Backboard brief model (cheapest capable) and daily cap
BACKBOARD_LLM_PROVIDER=google
BACKBOARD_MODEL=gemini-2.5-flash-lite
BACKBOARD_DAILY_CALL_LIMIT=60
