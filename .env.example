# Leave DATABASE_URL empty to use the embedded PGlite database in data/pglite (no setup).
# Tiger Cloud: postgres://user:pass@host:port/tsdb?sslmode=require
DATABASE_URL=
PGPASSWORD=                   # Tiger password (its console URL omits it); avoids URL-encoding issues
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_medical
USE_KEYTERMS=false            # keyterm prompting costs extra; enable only if quota allows
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash       # gemini-2.5-* is retired for new keys
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
BACKBOARD_API_KEY=
BACKBOARD_ENABLED=true
EMAIL_PROVIDER=gmail          # gmail | resend
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
AUTH_SECRET=                  # 32+ random chars
DEMO_FALLBACK=true            # on external failure, load cached results
DEMO_PATIENT_EMAIL=           # teammate inbox used for the seeded demo patient

# Free-tier guards (lib/usage.ts)
GEMINI_DAILY_CALL_LIMIT=400     # the live copilot makes ~20-30 calls per 10-minute visit
STT_DAILY_AUDIO_MINUTES=30
MAX_RECORDING_MINUTES=10

# Live copilot (Scribe v2 Realtime + Gemini checks while recording)
COPILOT_ENABLED=true             # false hides it; recording works exactly as before
COPILOT_MODEL=                   # empty = GEMINI_FALLBACK_MODEL (the main model's free tier is only 20 requests/day)
REALTIME_DAILY_MINUTES=60        # live audio reserved per day (each session reserves MAX_RECORDING_MINUTES)
REALTIME_DAILY_TOKEN_LIMIT=30    # live sessions per day

# Backboard brief model (cheapest capable) and daily cap
BACKBOARD_LLM_PROVIDER=google
BACKBOARD_MODEL=gemini-2.5-flash-lite
BACKBOARD_DAILY_CALL_LIMIT=60

# Snowflake Cortex chat ("Ask about this patient"). PAT: Snowsight > Settings > Authentication > Programmatic access tokens
SNOWFLAKE_ACCOUNT=                # account identifier, the part before .snowflakecomputing.com
SNOWFLAKE_PAT=
SNOWFLAKE_MODEL=llama3.1-70b
SNOWFLAKE_DAILY_CALL_LIMIT=100
